<!DOCTYPE html>
<html lang="es">
<head>
  <title>Sistema Comercial</title>
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <%= csrf_meta_tags %><%= csp_meta_tag %>
  <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
  <%= javascript_importmap_tags %>
</head>
<body class="bg-light">
<nav class="navbar navbar-dark bg-dark px-3">
  <%= link_to "Sistema Comercial", root_path, class: "navbar-brand fw-bold" %>
  <div class="text-white">
    <% if user_signed_in? %><span class="me-3"><%= current_user.email %></span><%= button_to "Cerrar sesión", destroy_user_session_path, method: :delete, class: "btn btn-outline-light btn-sm d-inline" %><% end %>
  </div>
</nav>
<div class="container-fluid">
  <div class="row">
    <% if user_signed_in? %>
      <aside class="col-md-2 bg-white border-end min-vh-100 p-3">
        <div class="nav flex-column gap-1">
          <%= link_to "Dashboard", root_path, class: "nav-link" %>
          <%= link_to "Productos", products_path, class: "nav-link" %>
          <%= link_to "Categorías", categories_path, class: "nav-link" %>
          <%= link_to "Marcas", brands_path, class: "nav-link" %>
          <%= link_to "Proveedores", suppliers_path, class: "nav-link" %>
          <%= link_to "Clientes", customers_path, class: "nav-link" %>
          <%= link_to "Compras", purchases_path, class: "nav-link" %>
          <%= link_to "Caja / ventas", sales_path, class: "nav-link" %>
          <%= link_to "Movimientos", inventory_movements_path, class: "nav-link" %>
          <hr>
          <%= link_to "Reporte de inventario", reports_inventory_path(format: :html), class: "nav-link" %>
          <%= link_to "Inventario bajo", reports_low_stock_path, class: "nav-link" %>
          <%= link_to "Reporte de ventas", reports_sales_path, class: "nav-link" %>
          <%= link_to "Reporte de compras", reports_purchases_path, class: "nav-link" %>
          <%= link_to "Reporte de movimientos", reports_movements_path, class: "nav-link" %>
        </div>
      </aside>
    <% end %>
    <main class="<%= user_signed_in? ? 'col-md-10' : 'col-12' %> p-4">
      <% flash.each do |type, message| %><div class="alert <%= type == 'notice' ? 'alert-success' : 'alert-danger' %> alert-dismissible"><%= message %><button class="btn-close" data-bs-dismiss="alert"></button></div><% end %>
      <%= yield %>
    </main>
  </div>
</div>
</body>
</html>
