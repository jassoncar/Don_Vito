<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= content_for?(:title) ? yield(:title) : "Panel" %> · <%= app_name %></title>
  <%= csrf_meta_tags %>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
  <link rel="icon" type="image/png" href="/favicon.png">
  <style>
    :root {
      --carbon: #151515; --gold: #D6A443; --gold-dark: #B8892B; --ivory: #151515; --green: #dce8e3; --green-soft: #DDE6E0; --is-green: #ffffff;
      --brand: var(--gold); --sidebar-w: 260px;
      --bs-body-bg: var(--is-green); --bs-body-color: #1d1d1b;
      --bs-primary: #D6A443; --bs-primary-rgb: 214, 164, 67;
      --bs-link-color: #e4f3ec; --bs-link-color-rgb: 38, 59, 50; --bs-link-hover-color: #a3812c; --bs-link-hover-color-rgb: 21, 21, 21;
      /* Colores funcionales (reservados para éxito / alerta / error / información) */
      --bs-success: #2E7D32; --bs-success-rgb: 46, 125, 50; --bs-success-bg-subtle: #E3F1E4; --bs-success-border-subtle: #B7DBB9; --bs-success-text-emphasis: #1B4D1E;
      --bs-warning: #E65100; --bs-warning-rgb: 230, 81, 0; --bs-warning-bg-subtle: #FFEBDD; --bs-warning-border-subtle: #FFC9A3; --bs-warning-text-emphasis: #8A3000;
      --bs-danger: #C62828; --bs-danger-rgb: 198, 40, 40; --bs-danger-bg-subtle: #FBE4E4; --bs-danger-border-subtle: #F0B3B3; --bs-danger-text-emphasis: #7A1717;
      --bs-info: #0277BD; --bs-info-rgb: 2, 119, 189; --bs-info-bg-subtle: #E1F0FA; --bs-info-border-subtle: #A9D3EE; --bs-info-text-emphasis: #01486F;
    }
    body { background: var(--ivory); }
    .bg-white { background-color: #FFFEFB !important; }
    .card { border: 1px solid #E6DFCF; background: #FFFEFB; box-shadow: 0 1px 2px rgba(21,21,21,.05); }
    .table-light { --bs-table-bg: #EEE8D8; --bs-table-color: #151515; --bs-table-border-color: #E0D8C4; }
    .table-hover > tbody > tr:hover > * { --bs-table-hover-bg: #F8F3E6; }

    /* Navegación: negro carbón + dorado */
    .sidebar { width: var(--sidebar-w); background: var(--carbon); }
    .sidebar .nav-heading { color: #8d8672; font-size: .7rem; text-transform: uppercase; letter-spacing: .08em; margin: 1rem 1rem .25rem; list-style: none; }
    .sidebar .nav-link { color: #d9d4c7; border-radius: .4rem; margin: 1px .5rem; padding: .45rem .75rem; }
    .sidebar .nav-link:hover { background: #242424; color: #fff; }
    .sidebar .nav-link.active { background: var(--gold); color: var(--carbon); font-weight: 600; }
    .sidebar .nav-link i { width: 1.4rem; display: inline-block; }
    .sidebar .sidebar-logo { display: block; width: 150px; max-width: 70%; margin: .25rem auto; }
    .topbar-mobile { background: var(--carbon); border-bottom: 2px solid var(--gold); }
    @media (min-width: 992px) { .content-wrap { margin-left: var(--sidebar-w); } .sidebar { position: fixed; top: 0; bottom: 0; left: 0; overflow-y: auto; } }

    /* Botones: dorado destacado, verde botella secundario */
    .btn-primary { --bs-btn-color: #151515; --bs-btn-bg: #D6A443; --bs-btn-border-color: #D6A443; --bs-btn-hover-color: #151515; --bs-btn-hover-bg: #C4922F; --bs-btn-hover-border-color: #C4922F; --bs-btn-active-color: #151515; --bs-btn-active-bg: #B8892B; --bs-btn-active-border-color: #B8892B; --bs-btn-disabled-color: #151515; --bs-btn-disabled-bg: #D6A443; --bs-btn-disabled-border-color: #D6A443; font-weight: 600; }
    .btn-secondary { --bs-btn-color: #fff; --bs-btn-bg: #e4f3ec; --bs-btn-border-color: #e4f3ec; --bs-btn-hover-color: #fff; --bs-btn-hover-bg: #1B2B24; --bs-btn-hover-border-color: #1B2B24; --bs-btn-active-bg: #15241d; --bs-btn-active-border-color: #15241d; }
    .btn-outline-primary { --bs-btn-color: #e4f3ec; --bs-btn-border-color: #e4f3ec; --bs-btn-hover-color: #fff; --bs-btn-hover-bg: #e4f3ec; --bs-btn-hover-border-color: #e4f3ec; --bs-btn-active-color: #fff; --bs-btn-active-bg: #1B2B24; --bs-btn-active-border-color: #1B2B24; }
    .btn-success { --bs-btn-bg: #2E7D32; --bs-btn-border-color: #2E7D32; --bs-btn-hover-bg: #256628; --bs-btn-hover-border-color: #256628; --bs-btn-active-bg: #1E5421; --bs-btn-active-border-color: #1E5421; }
    .btn-outline-success { --bs-btn-color: #2E7D32; --bs-btn-border-color: #2E7D32; --bs-btn-hover-bg: #2E7D32; --bs-btn-hover-border-color: #2E7D32; --bs-btn-active-bg: #256628; }
    .btn-danger { --bs-btn-bg: #C62828; --bs-btn-border-color: #C62828; --bs-btn-hover-bg: #A82020; --bs-btn-hover-border-color: #A82020; --bs-btn-active-bg: #8E1A1A; --bs-btn-active-border-color: #8E1A1A; }
    .btn-outline-danger { --bs-btn-color: #C62828; --bs-btn-border-color: #C62828; --bs-btn-hover-bg: #C62828; --bs-btn-hover-border-color: #C62828; --bs-btn-active-bg: #A82020; }
    .btn-outline-warning { --bs-btn-color: #E65100; --bs-btn-border-color: #E65100; --bs-btn-hover-color: #fff; --bs-btn-hover-bg: #E65100; --bs-btn-hover-border-color: #E65100; --bs-btn-active-bg: #BF4400; }
    .nav-pills { --bs-nav-pills-link-active-bg: #5a635f; --bs-nav-pills-link-active-color: #fff; }
    .form-control:focus, .form-select:focus { border-color: var(--gold); box-shadow: 0 0 0 .2rem rgba(214,164,67,.25); }
    .form-check-input:checked { background-color: var(--green); border-color: var(--green); }
    .form-check-input:focus { border-color: var(--gold); box-shadow: 0 0 0 .2rem rgba(214,164,67,.25); }
    .page-link { color: var(--green); }
    .page-item.active .page-link { background: var(--green); border-color: var(--green); color: #fff; }

    /* Tarjetas de indicadores */
    .stat-card .icon { width: 3rem; height: 3rem; border-radius: .75rem; display: flex; align-items: center; justify-content: center; font-size: 1.4rem; }
    .icon-gold { background: #F6EBCF; color: #8A6512; }
    .icon-green { background: var(--green-soft); color: var(--green); }
    .icon-success { background: #E3F1E4; color: #2E7D32; }
    .icon-danger { background: #FBE4E4; color: #C62828; }

    /* Imágenes de producto */
    .thumb { width: 44px; height: 44px; object-fit: cover; border-radius: .4rem; border: 1px solid #E0D8C4; background: #fff; }
    .thumb-ph { width: 44px; height: 44px; border-radius: .4rem; border: 1px dashed #CFC6AE; display: inline-flex; align-items: center; justify-content: center; color: #A89F86; background: #FAF7EE; }
    .pos-card { transition: box-shadow .15s, transform .15s; border: 1px solid #E6DFCF !important; }
    .pos-card:hover { box-shadow: 0 4px 12px rgba(21,21,21,.12) !important; transform: translateY(-1px); border-color: var(--gold) !important; }
    .pos-img { width: 100%; height: 96px; object-fit: contain; background: #fff; border-radius: .4rem; margin-bottom: .5rem; }
    .pos-img-ph { width: 100%; height: 96px; display: flex; align-items: center; justify-content: center; font-size: 2rem; color: #BDB49B; background: #FAF7EE; border-radius: .4rem; margin-bottom: .5rem; }
    .num { font-variant-numeric: tabular-nums; }
    .title-h1 { color: #d6a443 !important; }
  </style>
</head>
<body>
<nav class="navbar topbar-mobile d-lg-none sticky-top">
  <div class="container-fluid">
    <button class="btn btn-outline-light" data-bs-toggle="offcanvas" data-bs-target="#sidebar"><i class="bi bi-list"></i></button>
    <img src="/images/logo-mark.png" alt="<%= app_name %>" height="34">
    <span></span>
  </div>
</nav>

<aside class="sidebar offcanvas-lg offcanvas-start text-white d-flex flex-column" tabindex="-1" id="sidebar">
  <div class="p-3 d-flex align-items-center justify-content-between">
    <a href="<%= dashboard_path %>" class="flex-grow-1"><img src="/images/logo-dark.png" alt="<%= app_name %>" class="sidebar-logo"></a>
    <button type="button" class="btn-close btn-close-white d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#sidebar"></button>
  </div>

  <div class="flex-grow-1">
    <ul class="nav flex-column">
      <% menu_groups.each do |heading, items| %>
        <% visible = items.select { |item| item[3].nil? || can?(item[3]) } %>
        <% if visible.any? %>
          <li class="nav-heading"><%= heading %></li>
          <% visible.each do |label, icon, path, _permission, active| %>
            <li class="nav-item">
              <a class="nav-link <%= 'active' if active %>" href="<%= path %>"><i class="bi <%= icon %>"></i> <%= label %></a>
            </li>
          <% end %>
        <% end %>
      <% end %>
    </ul>
  </div>

  <div class="p-3 border-top border-secondary">
    <a href="<%= edit_profile_path %>" class="text-decoration-none text-white d-block">
      <i class="bi bi-person-circle"></i> <%= current_user.name %>
      <div class="small text-secondary"><%= current_user.role&.name || "Sin rol" %></div>
    </a>
    <%= button_to logout_path, method: :delete, class: "btn btn-sm btn-outline-light w-100 mt-2" do %>
      <i class="bi bi-box-arrow-right"></i> Cerrar sesión
    <% end %>
  </div>
</aside>

<div class="content-wrap">
  <main class="p-3 p-lg-4">
    <% if notice.present? %>
      <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle"></i> <%= notice %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% end %>
    <% if alert.present? %>
      <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle"></i> <%= alert %>
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    <% end %>
    <% if @errors.present? %>
      <div class="alert alert-danger">
        <strong>Revise los siguientes errores:</strong>
        <ul class="mb-0"><% @errors.each do |error| %><li><%= error %></li><% end %></ul>
      </div>
    <% end %>

    <%= yield %>
  </main>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<%= yield :scripts %>
</body>
</html>
