<h1 class="h3 mb-3">Registrar compra</h1>
<%= form_with url: purchases_path, scope: :purchase do |f| %>
<div class="mb-3"><%= f.label :supplier_id, "Proveedor", class: "form-label" %><%= f.collection_select :supplier_id, @suppliers, :id, :name, {prompt: "Selecciona proveedor"}, class: "form-select", required: true %></div>
<p class="text-muted">Agrega hasta cinco líneas de compra; las líneas vacías se ignoran.</p>
<% 5.times do |i| %><div class="row g-2 mb-2"><div class="col-md-6"><label class="form-label">Producto <%= i+1 %></label><select name="items[][product_id]" class="form-select"><option value="">Seleccionar producto</option><% @products.each do |p| %><option value="<%= p.id %>"><%= p.sku %> — <%= p.name %></option><% end %></select></div><div class="col-md-3"><label class="form-label">Cantidad</label><input name="items[][quantity]" type="number" min="1" class="form-control"></div><div class="col-md-3"><label class="form-label">Costo unitario</label><input name="items[][unit_cost]" type="number" min="0" step="0.01" class="form-control"></div></div><% end %>
<%= f.submit "Guardar compra", class: "btn btn-primary mt-3" %>
<% end %>
