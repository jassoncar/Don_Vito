<% content_for :title, "Órdenes de compra" %>
<% tabs = { "" => "Todas", "ordered" => "Ordenadas", "received" => "Recibidas", "cancelled" => "Canceladas" } %>
<div class="title-h1 d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="title-h1 h3 mb-0"><%= params[:status] == "received" ? "Órdenes recibidas" : "Órdenes de compra" %></h1>
  <% if can?("purchases.create") %><a href="<%= new_purchase_path %>" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nueva orden</a><% end %>
</div>

<ul class="nav nav-pills mb-3">
  <% tabs.each do |key, label| %>
    <li class="nav-item"><a class="nav-link <%= 'active' if params[:status].to_s == key %>" href="<%= purchases_path(status: key.presence, q: params[:q].presence) %>"><%= label %></a></li>
  <% end %>
</ul>

<form method="get" class="card card-body mb-3">
  <input type="hidden" name="status" value="<%= params[:status] %>">
  <div class="input-group">
    <input type="text" name="q" value="<%= params[:q] %>" class="form-control" placeholder="Buscar por código o proveedor...">
    <button class="btn btn-outline-secondary"><i class="bi bi-search"></i></button>
  </div>
</form>

<div class="card"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Código</th><th>Fecha</th><th>Proveedor</th><th>Registró</th><th>Estado</th><th class="text-end">Total</th><th></th></tr></thead>
    <tbody>
      <% @purchases.each do |purchase| %>
        <tr>
          <td class="fw-semibold"><%= purchase.code %></td>
          <td><%= purchase.ordered_at.strftime("%d/%m/%Y") %></td>
          <td><%= purchase.supplier&.name %></td>
          <td><%= purchase.user&.name %></td>
          <td><%= badge(purchase.status_label, status_color(purchase.status)) %></td>
          <td class="text-end num"><%= money(purchase.total) %></td>
          <td class="text-end"><a href="<%= purchase_path(purchase) %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
        </tr>
      <% end %>
      <% if @purchases.empty? %><tr><td colspan="7" class="text-center text-muted py-4">No hay órdenes.</td></tr><% end %>
    </tbody>
  </table>
</div><div class="card-footer bg-white"><%= render "shared/pagination" %></div></div>
