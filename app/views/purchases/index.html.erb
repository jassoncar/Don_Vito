<div class="d-flex justify-content-between mb-3"><h1 class="h3">Compras</h1><%= link_to "Registrar compra", new_purchase_path, class: "btn btn-primary" %></div>
<table class="table bg-white"><thead><tr><th>Referencia</th><th>Proveedor</th><th>Estado</th><th>Total</th><th>Fecha</th></tr></thead><tbody><% @purchases.each do |p| %><tr><td><%= link_to p.reference, purchase_path(p) %></td><td><%= p.supplier.name %></td><td><%= p.status.humanize %></td><td><%= number_to_currency(p.total, unit: "C$ ") %></td><td><%= l(p.created_at, format: :short) %></td></tr><% end %></tbody></table>
