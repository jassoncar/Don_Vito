<% content_for :title, "Orden #{@purchase.code}" %>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="h3 mb-0">Orden <%= @purchase.code %> <span class="badge bg-<%= status_color(@purchase.status) %> fs-6 align-middle"><%= @purchase.status_label %></span></h1>
  <div class="d-flex gap-2">
    <% if @purchase.status == "ordered" %>
      <% if can?("purchases.receive") %>
        <%= button_to receive_purchase_path(@purchase), class: "btn btn-success",
                      form: { onsubmit: "return confirm('¿Confirmar la recepción? Se aumentará el stock de los productos.')" } do %><i class="bi bi-box-arrow-in-down"></i> Marcar como recibida<% end %>
      <% end %>
      <% if can?("purchases.cancel") %>
        <%= button_to cancel_purchase_path(@purchase), class: "btn btn-outline-danger",
                      form: { onsubmit: "return confirm('¿Cancelar esta orden?')" } do %><i class="bi bi-x-circle"></i> Cancelar orden<% end %>
      <% end %>
    <% end %>
    <a href="<%= purchases_path %>" class="btn btn-outline-secondary">Volver</a>
  </div>
</div>

<div class="row g-3">
  <div class="col-lg-4"><div class="card card-body"><dl class="mb-0">
    <dt>Proveedor</dt><dd><%= @purchase.supplier&.name %></dd>
    <dt>Fecha de la orden</dt><dd><%= @purchase.ordered_at.strftime("%d/%m/%Y") %></dd>
    <dt>Registrada por</dt><dd><%= @purchase.user&.name %></dd>
    <dt>Recibida</dt><dd><%= @purchase.received_at&.strftime("%d/%m/%Y %H:%M") || "—" %></dd>
    <dt>Notas</dt><dd class="mb-0"><%= @purchase.notes.presence || "—" %></dd>
  </dl></div></div>
  <div class="col-lg-8"><div class="card"><div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light"><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Costo unit.</th><th class="text-end">Subtotal</th></tr></thead>
      <tbody>
        <% @purchase.purchase_items.each do |item| %>
          <tr><td><%= item.product&.name %> <small class="text-muted"><%= item.product&.sku %></small></td><td class="text-end"><%= item.quantity %></td><td class="text-end num"><%= money(item.unit_cost) %></td><td class="text-end num"><%= money(item.total) %></td></tr>
        <% end %>
      </tbody>
      <tfoot><tr><th colspan="3" class="text-end">Total</th><th class="text-end num"><%= money(@purchase.total) %></th></tr></tfoot>
    </table>
  </div></div></div>
</div>
