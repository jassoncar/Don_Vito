<h1 class="h3">Compra <%= @purchase.reference %></h1><p>Proveedor: <%= @purchase.supplier.name %> · Estado: <strong><%= @purchase.status.humanize %></strong></p>
<table class="table bg-white"><thead><tr><th>Producto</th><th>Cantidad</th><th>Costo unitario</th><th>Subtotal</th></tr></thead><tbody><% @purchase.purchase_items.each do |i| %><tr><td><%= i.product.name %></td><td><%= i.quantity %></td><td><%= number_to_currency(i.unit_cost, unit: "C$ ") %></td><td><%= number_to_currency(i.quantity*i.unit_cost, unit: "C$ ") %></td></tr><% end %></tbody></table><h4>Total: <%= number_to_currency(@purchase.total, unit: "C$ ") %></h4>
<% if @purchase.draft? %><%= button_to "Recibir mercancía", receive_purchase_path(@purchase), method: :patch, class: "btn btn-success", data: { turbo_confirm: "¿Confirmas la recepción? Esto aumentará existencias." } %><% end %>
