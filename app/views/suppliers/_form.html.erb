<%= form_with model: @supplier do |f| %><% if @supplier.errors.any? %><div class="alert alert-danger"><%= @supplier.errors.full_messages.to_sentence %></div><% end %>
<% {name: "Nombre", contact_name: "Persona de contacto", phone: "Teléfono", email: "Correo", address: "Dirección"}.each do |field,label| %><div class="mb-3"><%= f.label field, label, class: "form-label" %><%= f.text_field field, class: "form-control" %></div><% end %><%= f.check_box :active %> Activo <div class="mt-3"><%= f.submit "Guardar", class: "btn btn-primary" %></div><% end %>
