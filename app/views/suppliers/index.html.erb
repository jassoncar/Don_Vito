<div class="d-flex justify-content-between mb-3"><h1 class="h3">Proveedores</h1><%= link_to "Nuevo proveedor", new_supplier_path, class: "btn btn-primary" %></div>
<table class="table bg-white"><thead><tr><th>Proveedor</th><th>Contacto</th><th>Teléfono</th><th>Correo</th><th>Estado</th><th></th></tr></thead><tbody><% @suppliers.each do |s| %><tr><td><%= link_to s.name, supplier_path(s) %></td><td><%= s.contact_name %></td><td><%= s.phone %></td><td><%= s.email %></td><td><%= s.active ? "Activo" : "Inactivo" %></td><td><%= link_to "Editar", edit_supplier_path(s), class: "btn btn-sm btn-outline-secondary" %></td></tr><% end %></tbody></table>
