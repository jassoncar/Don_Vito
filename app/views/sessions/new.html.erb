<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Iniciar sesión · <%= app_name %></title>
  <%= csrf_meta_tags %>
  <link rel="icon" type="image/png" href="/favicon.png">
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <style>
    :root { --bs-danger-bg-subtle: #FBE4E4; --bs-danger-border-subtle: #F0B3B3; --bs-danger-text-emphasis: #7A1717; }
    body { min-height: 100vh; background: radial-gradient(circle at 20% 15%, #b98c13 0%, #151515 60%); }
    .login-card { max-width: 420px; width: 100%; background: #151515; border: 0; border-top: 4px solid #D6A443; }
    .login-card img { width: 190px; max-width: 70%; }
    .btn-primary { --bs-btn-color: #151515; --bs-btn-bg: #D6A443; --bs-btn-border-color: #D6A443; --bs-btn-hover-color: #151515; --bs-btn-hover-bg: #C4922F; --bs-btn-hover-border-color: #C4922F; --bs-btn-active-color: #151515; --bs-btn-active-bg: #B8892B; font-weight: 600; }
    .form-control:focus { border-color: #D6A443; box-shadow: 0 0 0 .2rem rgba(214,164,67,.25); }
  </style>
</head>
<body class="d-flex align-items-center justify-content-center p-3">
<div class="card login-card shadow-lg">
  <div class="card-body p-4 p-md-5">
    <div class="text-center mb-4">
      <img src="/images/logo-dark.png" alt="<%=   app_name %>">
      <div class="text-warning small mt-1">
        <h4 class="title-h1 h4 mb-0">
          Sistema de administración
        </h4>
      </div>
    </div>

    <% if alert.present? %><div class="alert alert-danger py-2"><%= alert %></div><% end %>
    <% if @error.present? %><div class="alert alert-danger py-2"><%= @error %></div><% end %>

    <%= form_with url: login_path, method: :post do %>
      <div class="mb-3 title-h1">
        <label class="form-label" for="email">Correo electrónico</label>
        <%= email_field_tag :email, @email, class: "form-control", required: true, autofocus: true %>
      </div>
      <div class="mb-3">
        <label class="form-label" for="password">Contraseña</label>
        <%= password_field_tag :password, nil, class: "form-control", required: true %>
      </div>
      <button class="btn btn-primary w-100">Ingresar</button>
    <% end %>
  </div>
</div>
</body>
</html>
