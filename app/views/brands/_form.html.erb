<%= form_with model: @brand do |f| %><% if @brand.errors.any? %><div class="alert alert-danger"><%= @brand.errors.full_messages.to_sentence %></div><% end %><div class="mb-3"><%= f.label :name, "Nombre", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div><%= f.check_box :active %> Activa <div class="mt-3"><%= f.submit "Guardar", class: "btn btn-primary" %></div><% end %>
