<div class="d-flex justify-content-between mb-3"><h1 class="h3">Marcas</h1><%= link_to "Nueva marca", new_brand_path, class: "btn btn-primary" %></div>
<table class="table bg-white"><thead><tr><th>Nombre</th><th>Estado</th><th></th></tr></thead><tbody><% @brands.each do |b| %><tr><td><%= b.name %></td><td><%= b.active ? "Activa" : "Inactiva" %></td><td><%= link_to "Editar", edit_brand_path(b), class: "btn btn-sm btn-outline-secondary" %> <%= button_to "Desactivar", brand_path(b), method: :delete, class: "btn btn-sm btn-outline-danger", form: { class: "d-inline" } %></td></tr><% end %></tbody></table>
