<div class="d-flex justify-content-between mb-3"><h1 class="h3">Categorías</h1><%= link_to "Nueva categoría", new_category_path, class: "btn btn-primary" %></div>
<table class="table bg-white"><thead><tr><th>Nombre</th><th>Descripción</th><th>Estado</th><th></th></tr></thead><tbody><% @categories.each do |c| %><tr><td><%= c.name %></td><td><%= c.description %></td><td><%= c.active ? "Activa" : "Inactiva" %></td><td><%= link_to "Editar", edit_category_path(c), class: "btn btn-sm btn-outline-secondary" %> <%= button_to "Desactivar", category_path(c), method: :delete, class: "btn btn-sm btn-outline-danger", form: { class: "d-inline" } %></td></tr><% end %></tbody></table>
