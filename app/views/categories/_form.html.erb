<%= form_with model: @category do |f| %><% if @category.errors.any? %><div class="alert alert-danger"><%= @category.errors.full_messages.to_sentence %></div><% end %><div class="mb-3"><%= f.label :name, "Nombre", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div><div class="mb-3"><%= f.label :description, "Descripción", class: "form-label" %><%= f.text_area :description, class: "form-control" %></div><%= f.check_box :active %> Activa <div class="mt-3"><%= f.submit "Guardar", class: "btn btn-primary" %></div><% end %>
