<div class="d-flex justify-content-between mb-3"><h1 class="h3">Reporte de ventas</h1><%= link_to "Exportar CSV", reports_sales_path(format: :csv), class: "btn btn-outline-primary" %></div><table class="table bg-white"><thead><tr><th>Referencia</th><th>Fecha</th><th>Cliente</th><th>Total</th></tr></thead><tbody><% @sales.each do |s| %><tr><td><%= s.reference %></td><td><%= s.created_at %></td><td><%= s.customer&.name %></td><td><%= number_to_currency(s.total, unit: "C$ ") %></td></tr><% end %></tbody></table>
