<div class="d-flex justify-content-between mb-3"><h1 class="h3">Reporte de movimientos</h1><%= link_to "Exportar CSV", reports_movements_path(format: :csv), class: "btn btn-outline-primary" %></div><table class="table bg-white"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Usuario</th></tr></thead><tbody><% @movements.each do |m| %><tr><td><%= m.created_at %></td><td><%= m.product.name %></td><td><%= m.movement_type %></td><td><%= m.quantity %></td><td><%= m.user.email %></td></tr><% end %></tbody></table>
