<% content_for :title, "Reportes" %>
<h1 class="title-h1 title-h1 h3 mb-3">Reportes</h1>
<div class="row g-3">
  <% report_types.each do |key, (label, description, uses_dates)| %>
    <div class="col-md-6 col-xl-4">
      <form method="get" action="<%= report_path(key) %>" class="card h-100">
        <div class="card-body">
          <h2 class="h5"><%= label %></h2>
          <p class="text-muted small"><%= description %></p>
          <% if uses_dates %>
            <div class="row g-2">
              <div class="col-6"><label class="form-label small mb-1">Desde</label><input type="date" name="from" value="<%= @from %>" class="form-control form-control-sm"></div>
              <div class="col-6"><label class="form-label small mb-1">Hasta</label><input type="date" name="to" value="<%= @to %>" class="form-control form-control-sm"></div>
            </div>
          <% end %>
        </div>
        <div class="card-footer bg-white d-flex flex-wrap gap-1">
          <button name="format_type" value="html" class="btn btn-sm btn-primary"><i class="bi bi-eye"></i> Ver</button>
          <button name="format_type" value="pdf" class="btn btn-sm btn-outline-danger"><i class="bi bi-file-earmark-pdf"></i> PDF</button>
          <button name="format_type" value="excel" class="btn btn-sm btn-outline-success"><i class="bi bi-file-earmark-excel"></i> Excel</button>
          <button name="format_type" value="csv" class="btn btn-sm btn-outline-secondary"><i class="bi bi-filetype-csv"></i> CSV</button>
        </div>
      </form>
    </div>
  <% end %>
</div>
