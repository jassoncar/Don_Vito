<div class="d-flex justify-content-between mb-3"><h1 class="h3">Reporte de inventario</h1><%= link_to "Exportar CSV", reports_inventory_path(format: :csv), class: "btn btn-outline-primary" %></div>
<table class="table bg-white"><thead><tr><th>SKU</th><th>Producto</th><th>Categoría</th><th>Stock</th><th>Costo</th><th>Precio</th><th>Valor</th></tr></thead><tbody><% @products.each do |p| %><tr><td><%= p.sku %></td><td><%= p.name %></td><td><%= p.category.name %></td><td><%= p.stock %></td><td><%= p.cost_price %></td><td><%= p.sale_price %></td><td><%= p.stock*p.cost_price %></td></tr><% end %></tbody></table>
