<div class="d-flex justify-content-between mb-3"><h1 class="h3">Reporte de compras</h1><%= link_to "Exportar CSV", reports_purchases_path(format: :csv), class: "btn btn-outline-primary" %></div><table class="table bg-white"><thead><tr><th>Referencia</th><th>Proveedor</th><th>Estado</th><th>Total</th></tr></thead><tbody><% @purchases.each do |p| %><tr><td><%= p.reference %></td><td><%= p.supplier.name %></td><td><%= p.status %></td><td><%= number_to_currency(p.total, unit: "C$ ") %></td></tr><% end %></tbody></table>
