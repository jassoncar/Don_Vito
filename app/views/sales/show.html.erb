<div class="d-flex justify-content-between"><h1 class="h3">Comprobante <%= @sale.reference %></h1><button class="btn btn-outline-secondary" onclick="window.print()">Imprimir</button></div><p>Fecha: <%= l(@sale.created_at, format: :long) %> · Cajero: <%= @sale.user.email %> · Cliente: <%= @sale.customer&.name || "Venta general" %></p>
<table class="table"><thead><tr><th>Producto</th><th>Cantidad</th><th>Precio</th><th>Subtotal</th></tr></thead><tbody><% @sale.sale_items.each do |i| %><tr><td><%= i.product.name %></td><td><%= i.quantity %></td><td><%= number_to_currency(i.unit_price, unit: "C$ ") %></td><td><%= number_to_currency(i.subtotal, unit: "C$ ") %></td></tr><% end %></tbody></table>
<div class="text-end"><p>Subtotal: <%= number_to_currency(@sale.subtotal, unit: "C$ ") %></p><p>Descuento: <%= number_to_currency(@sale.discount, unit: "C$ ") %></p><p>Impuesto: <%= number_to_currency(@sale.tax, unit: "C$ ") %></p><h3>Total: <%= number_to_currency(@sale.total, unit: "C$ ") %></h3><p>Pago: <%= @sale.payment_method.humanize %></p></div>
