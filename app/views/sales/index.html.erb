<div class="d-flex justify-content-between mb-3"><h1 class="h3">Caja / ventas</h1><%= link_to "Nueva venta", new_sale_path, class: "btn btn-primary" %></div>
<table class="table bg-white"><thead><tr><th>Referencia</th><th>Cliente</th><th>Usuario</th><th>Pago</th><th>Total</th><th>Fecha</th></tr></thead><tbody><% @sales.each do |s| %><tr><td><%= link_to s.reference, sale_path(s) %></td><td><%= s.customer&.name || "Venta general" %></td><td><%= s.user.email %></td><td><%= s.payment_method.humanize %></td><td><%= number_to_currency(s.total, unit: "C$ ") %></td><td><%= l(s.created_at, format: :short) %></td></tr><% end %></tbody></table>
