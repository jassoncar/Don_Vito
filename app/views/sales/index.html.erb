<% content_for :title, "Ventas" %>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
  <h1 class="title-h1 title-h1 h3 mb-0">Ventas</h1>
  <% if can?("sales.create") %><a href="<%= pos_path %>" class="btn btn-primary"><i class="bi bi-cart-plus"></i> Nueva venta</a><% end %>
</div>

<form method="get" class="card card-body mb-3"><div class="row g-2">
  <div class="col-md-3"><input type="text" name="q" value="<%= params[:q] %>" class="form-control" placeholder="Código o cliente"></div>
  <div class="col-md-2"><input type="date" name="from" value="<%= params[:from] %>" class="form-control" title="Desde"></div>
  <div class="col-md-2"><input type="date" name="to" value="<%= params[:to] %>" class="form-control" title="Hasta"></div>
  <div class="col-md-2"><%= select_tag :status, options_for_select(Sale::STATUSES.map { |k, v| [v, k] }, params[:status]), include_blank: "Todos los estados", class: "form-select" %></div>
  <div class="col-md-2"><%= select_tag :user_id, options_from_collection_for_select(@users, :id, :name, params[:user_id]), include_blank: "Todos los vendedores", class: "form-select" %></div>
  <div class="col-md-1 d-grid"><button class="btn btn-outline-secondary"><i class="bi bi-funnel"></i></button></div>
</div></form>

<div class="card"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Código</th><th>Fecha</th><th>Cliente</th><th>Vendedor</th><th>Pago</th><th>Estado</th><th class="text-end">Total</th><th></th></tr></thead>
    <tbody>
      <% @sales.each do |sale| %>
        <tr>
          <td class="fw-semibold"><%= sale.code %></td>
          <td><%= sale.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td><%= sale.customer&.name || "Consumidor final" %></td>
          <td><%= sale.user&.name %></td>
          <td><%= sale.payment_label %></td>
          <td><%= badge(sale.status_label, status_color(sale.status)) %></td>
          <td class="text-end num"><%= money(sale.total) %></td>
          <td class="text-end"><a href="<%= sale_path(sale) %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
        </tr>
      <% end %>
      <% if @sales.empty? %><tr><td colspan="8" class="text-center text-muted py-4">No hay ventas con esos filtros.</td></tr><% end %>
    </tbody>
  </table>
</div><div class="card-footer bg-white"><%= render "shared/pagination" %></div></div>
