<%= form_with model: @product do |f| %>
  <% if @product.errors.any? %><div class="alert alert-danger"><%= @product.errors.full_messages.to_sentence %></div><% end %>
  <div class="row g-3">
    <div class="col-md-4"><%= f.label :sku, "SKU", class: "form-label" %><%= f.text_field :sku, class: "form-control", required: true %></div>
    <div class="col-md-4"><%= f.label :barcode, "Código de barras", class: "form-label" %><%= f.text_field :barcode, class: "form-control" %></div>
    <div class="col-md-4"><%= f.label :name, "Nombre", class: "form-label" %><%= f.text_field :name, class: "form-control", required: true %></div>
    <div class="col-md-6"><%= f.label :category_id, "Categoría", class: "form-label" %><%= f.collection_select :category_id, Category.order(:name), :id, :name, {prompt: "Selecciona"}, class: "form-select", required: true %></div>
    <div class="col-md-6"><%= f.label :brand_id, "Marca", class: "form-label" %><%= f.collection_select :brand_id, Brand.order(:name), :id, :name, {include_blank: "Sin marca"}, class: "form-select" %></div>
    <div class="col-md-12"><%= f.label :description, "Descripción", class: "form-label" %><%= f.text_area :description, class: "form-control", rows: 2 %></div>
    <div class="col-md-3"><%= f.label :cost_price, "Costo", class: "form-label" %><%= f.number_field :cost_price, step: "0.01", min: 0, class: "form-control", required: true %></div>
    <div class="col-md-3"><%= f.label :sale_price, "Precio de venta", class: "form-label" %><%= f.number_field :sale_price, step: "0.01", min: 0, class: "form-control", required: true %></div>
    <div class="col-md-3"><%= f.label :stock, "Existencias iniciales", class: "form-label" %><%= f.number_field :stock, min: 0, class: "form-control", required: true %></div>
    <div class="col-md-3"><%= f.label :minimum_stock, "Existencia mínima", class: "form-label" %><%= f.number_field :minimum_stock, min: 0, class: "form-control", required: true %></div>
    <div class="col-12 form-check ms-2"><%= f.check_box :active, class: "form-check-input" %><%= f.label :active, "Activo", class: "form-check-label" %></div>
  </div>
  <div class="mt-4"><%= f.submit "Guardar", class: "btn btn-primary" %> <%= link_to "Cancelar", products_path, class: "btn btn-outline-secondary" %></div>
<% end %>
