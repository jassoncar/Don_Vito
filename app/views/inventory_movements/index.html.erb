<div class="d-flex justify-content-between mb-3"><h1 class="h3">Movimientos de inventario</h1><%= link_to "Nuevo ajuste", new_inventory_movement_path, class: "btn btn-primary" %></div>
<table class="table bg-white"><thead><tr><th>Fecha</th><th>Producto</th><th>Movimiento</th><th>Cantidad</th><th>Usuario</th><th>Nota</th></tr></thead><tbody><% @movements.each do |m| %><tr><td><%= l(m.created_at, format: :short) %></td><td><%= m.product.name %></td><td><%= m.movement_type.humanize %></td><td><%= m.quantity %></td><td><%= m.user.email %></td><td><%= m.note %></td></tr><% end %></tbody></table>
