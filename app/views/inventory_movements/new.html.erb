<h1 class="h3">Ajuste de inventario</h1><%= form_with model: @movement do |f| %><div class="mb-3"><%= f.label :product_id, "Producto", class: "form-label" %><%= f.collection_select :product_id, @products, :id, :name, {prompt: "Selecciona"}, class: "form-select", required: true %></div><div class="mb-3"><%= f.label :movement_type, "Tipo", class: "form-label" %><%= f.select :movement_type, [["Entrada por ajuste","adjustment_in"],["Salida por ajuste","adjustment_out"],["Devolución","return_in"]], {}, class: "form-select" %></div><div class="mb-3"><%= f.label :quantity, "Cantidad", class: "form-label" %><%= f.number_field :quantity, min: 1, class: "form-control", required: true %></div><div class="mb-3"><%= f.label :note, "Motivo", class: "form-label" %><%= f.text_field :note, class: "form-control", required: true %></div><%= f.submit "Registrar ajuste", class: "btn btn-primary" %><% end %>
