<% content_for :title, "Dashboard" %>
<h1 class="title-h1 h3 mb-4">Dashboard</h1>

<% cards = [
  ["Ventas de hoy", money(@stats[:sales_today]), "#{@stats[:sales_today_count]} venta(s)", "bi-cash-coin", "success"],
  ["Ventas del mes", money(@stats[:sales_month]), "Acumulado del mes", "bi-graph-up-arrow", "gold"],
  ["Productos activos", @stats[:products], "En catálogo", "bi-box-seam", "green"],
  ["Stock bajo", @stats[:low_stock], "#{@stats[:pending_purchases]} orden(es) de compra pendiente(s)", "bi-exclamation-triangle", "danger"]
] %>
<div class="row g-3 mb-4">
  <% cards.each do |label, value, hint, icon, color| %>
    <div class="col-sm-6 col-xl-3">
      <div class="card stat-card h-100"><div class="card-body d-flex align-items-center gap-3">
        <div class="icon icon-<%= color %>"><i class="bi <%= icon %>"></i></div>
        <div>
          <div class="text-muted small"><%= label %></div>
          <div class="fs-4 fw-semibold num"><%= value %></div>
          <div class="text-muted small"><%= hint %></div>
        </div>
      </div></div>
    </div>
  <% end %>
</div>

<div class="row g-3">
  <div class="col-lg-8">
    <div class="card mb-3">
      <div class="card-header bg-white fw-semibold">Ventas de los últimos 7 días</div>
      <div class="card-body"><canvas id="salesChart" height="110"></canvas></div>
    </div>
    <div class="card">
      <div class="card-header bg-white fw-semibold d-flex justify-content-between">
        Últimas ventas
        <% if can?("sales.view") %><a href="<%= sales_path %>" class="small">Ver todas</a><% end %>
      </div>
      <div class="table-responsive">
        <table class="table table-sm align-middle mb-0">
          <thead class="table-light"><tr><th>Código</th><th>Cliente</th><th>Vendedor</th><th class="text-end">Total</th></tr></thead>
          <tbody>
            <% @recent_sales.each do |sale| %>
              <tr>
                <td>
                  <% if can?("sales.view") %><a href="<%= sale_path(sale) %>"><%= sale.code %></a><% else %><%= sale.code %><% end %>
                  <% if sale.status != "completed" %><%= badge(sale.status_label) %><% end %>
                </td>
                <td><%= sale.customer&.name || "Consumidor final" %></td>
                <td><%= sale.user&.name %></td>
                <td class="text-end num"><%= money(sale.total) %></td>
              </tr>
            <% end %>
            <% if @recent_sales.empty? %><tr><td colspan="4" class="text-center text-muted py-3">Aún no hay ventas.</td></tr><% end %>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <div class="col-lg-4">
    <div class="card">
      <div class="card-header bg-white fw-semibold">Productos con stock bajo</div>
      <ul class="list-group list-group-flush">
        <% @low_stock_products.each do |product| %>
          <li class="list-group-item d-flex justify-content-between align-items-center">
            <span><%= product.name %><br><small class="text-muted">Mínimo: <%= product.min_stock %></small></span>
            <span class="badge bg-danger rounded-pill"><%= product.stock %></span>
          </li>
        <% end %>
        <% if @low_stock_products.empty? %><li class="list-group-item text-muted">Todo el inventario está por encima del mínimo.</li><% end %>
      </ul>
    </div>
  </div>
</div>

<% content_for :scripts do %>
  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.3/dist/chart.umd.min.js"></script>
  <script>
    new Chart(document.getElementById('salesChart'), {
      type: 'bar',
      data: { labels: <%= raw @chart[:labels].to_json %>, datasets: [{ label: 'Ventas', data: <%= raw @chart[:data].to_json %>, backgroundColor: '#b45309', borderRadius: 4 }] },
      options: { plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true } } }
    });
  </script>
<% end %>
