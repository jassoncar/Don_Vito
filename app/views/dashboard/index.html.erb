<h1 class="h3 mb-4">Panel de control</h1>
<div class="row g-3 mb-4">
  <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted">Productos</div><div class="display-6"><%= @products_count %></div></div></div></div>
  <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted">Inventario bajo</div><div class="display-6 text-danger"><%= @low_stock_count %></div></div></div></div>
  <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted">Valor de inventario</div><div class="display-6"><%= number_to_currency(@inventory_value, unit: "C$ ") %></div></div></div></div>
  <div class="col-md-3"><div class="card shadow-sm"><div class="card-body"><div class="text-muted">Movimientos recientes</div><div class="display-6"><%= @recent_movements.size %></div></div></div></div>
</div>
<div class="d-flex justify-content-between align-items-center mb-2"><h2 class="h5">Movimientos recientes</h2><%= link_to "Ver todos", inventory_movements_path, class: "btn btn-sm btn-outline-primary" %></div>
<div class="table-responsive bg-white rounded shadow-sm"><table class="table table-striped mb-0"><thead><tr><th>Fecha</th><th>Producto</th><th>Tipo</th><th>Cantidad</th><th>Usuario</th></tr></thead><tbody>
<% @recent_movements.each do |m| %><tr><td><%= l(m.created_at, format: :short) %></td><td><%= m.product.name %></td><td><%= m.movement_type.humanize %></td><td><%= m.quantity %></td><td><%= m.user.email %></td></tr><% end %>
</tbody></table></div>
