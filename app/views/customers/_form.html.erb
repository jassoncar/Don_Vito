<%= form_with model: @customer do |f| %><% if @customer.errors.any? %><div class="alert alert-danger"><%= @customer.errors.full_messages.to_sentence %></div><% end %>
<% {name: "Nombre", phone: "Teléfono", email: "Correo", address: "Dirección"}.each do |field,label| %><div class="mb-3"><%= f.label field, label, class: "form-label" %><%= f.text_field field, class: "form-control" %></div><% end %><%= f.submit "Guardar", class: "btn btn-primary" %><% end %>
