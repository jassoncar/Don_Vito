<% content_for :title, "Ajustes de inventario" %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="title-h1 h3 mb-0">Ajustes de inventario</h1>
  <% if can?("inventory.adjust") %><a href="<%= new_adjustment_path %>" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Nuevo ajuste</a><% end %>
</div>
<div class="card"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Código</th><th>Fecha</th><th>Producto</th><th>Tipo</th><th class="text-end">Cantidad</th><th>Motivo</th><th>Usuario</th></tr></thead>
    <tbody>
      <% @adjustments.each do |adj| %>
        <tr>
          <td class="fw-semibold"><%= adj.code %></td>
          <td><%= adj.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td><%= adj.product&.name %></td>
          <td><%= badge(adj.kind == "in" ? "Entrada" : "Salida", adj.kind == "in" ? "success" : "danger") %></td>
          <td class="text-end"><%= adj.quantity %></td>
          <td><%= adj.reason %> <% if adj.notes.present? %><small class="text-muted">— <%= adj.notes %></small><% end %></td>
          <td><%= adj.user&.name %></td>
        </tr>
      <% end %>
      <% if @adjustments.empty? %><tr><td colspan="7" class="text-center text-muted py-4">No hay ajustes registrados.</td></tr><% end %>
    </tbody>
  </table>
</div><div class="card-footer bg-white"><%= render "shared/pagination" %></div></div>
