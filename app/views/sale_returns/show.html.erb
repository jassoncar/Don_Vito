<% content_for :title, "Devolución #{@return.code}" %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="title-h1 h3 mb-0">Devolución <%= @return.code %></h1>
  <a href="<%= returns_path %>" class="btn btn-outline-secondary">Volver</a>
</div>
<div class="row g-3">
  <div class="col-lg-4"><div class="card card-body"><dl class="mb-0">
    <dt>Venta</dt><dd><% if can?("sales.view") %><a href="<%= sale_path(@return.sale_id) %>"><%= @return.sale&.code %></a><% else %><%= @return.sale&.code %><% end %></dd>
    <dt>Fecha</dt><dd><%= @return.created_at.strftime("%d/%m/%Y %H:%M") %></dd>
    <dt>Registró</dt><dd><%= @return.user&.name %></dd>
    <dt>Motivo</dt><dd class="mb-0"><%= @return.reason %></dd>
  </dl></div></div>
  <div class="col-lg-8"><div class="card"><div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light"><tr><th>Producto</th><th class="text-end">Cantidad</th><th class="text-end">Monto</th></tr></thead>
      <tbody>
        <% @return.sale_return_items.each do |item| %>
          <tr><td><%= item.product&.name %></td><td class="text-end"><%= item.quantity %></td><td class="text-end num"><%= money(item.amount) %></td></tr>
        <% end %>
      </tbody>
      <tfoot><tr><th colspan="2" class="text-end">Total devuelto</th><th class="text-end num"><%= money(@return.total) %></th></tr></tfoot>
    </table>
  </div></div></div>
</div>
