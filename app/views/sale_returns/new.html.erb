<% content_for :title, "Devolución de #{@sale.code}" %>
<h1 class="title-h1 h3 mb-1">Devolución de la venta <%= @sale.code %></h1>
<p class="text-muted">Cliente: <%= @sale.customer&.name || "Consumidor final" %> · <%= @sale.created_at.strftime("%d/%m/%Y %H:%M") %>.
  Indique la cantidad a devolver de cada producto; el stock se reintegra automáticamente.</p>

<%= form_with url: sale_returns_path(@sale), method: :post do %>
  <div class="card mb-3"><div class="table-responsive">
    <table class="table align-middle mb-0">
      <thead class="table-light"><tr><th>Producto</th><th class="text-end">Vendidas</th><th class="text-end">Ya devueltas</th><th class="text-end">Precio unit.</th><th style="width:150px">Devolver</th></tr></thead>
      <tbody>
        <% @sale.sale_items.each_with_index do |item, i| %>
          <tr>
            <td><%= item.product&.name %><%= hidden_field_tag "items[#{i}][sale_item_id]", item.id, id: nil %></td>
            <td class="text-end"><%= item.quantity %></td>
            <td class="text-end"><%= item.returned_qty %></td>
            <td class="text-end num"><%= money(item.unit_price) %></td>
            <td><%= number_field_tag "items[#{i}][quantity]", 0, min: 0, max: item.returnable, step: 1, id: nil, class: "form-control", disabled: item.returnable.zero? %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div></div>

  <div class="card card-body mb-3">
    <label class="form-label" for="reason">Motivo de la devolución</label>
    <%= text_field_tag :reason, params[:reason], class: "form-control", maxlength: 255, required: true %>
  </div>

  <div class="d-flex gap-2">
    <button class="btn btn-primary"><i class="bi bi-check-lg"></i> Registrar devolución</button>
    <a href="<%= sale_path(@sale) %>" class="btn btn-outline-secondary">Cancelar</a>
  </div>
<% end %>
