<% content_for :title, "Devoluciones" %>
<h1 class="title-h1 h3 mb-3">Devoluciones</h1>
<p class="text-muted">Las devoluciones se registran desde el detalle de cada venta.</p>
<div class="card"><div class="table-responsive">
  <table class="table table-hover align-middle mb-0">
    <thead class="table-light"><tr><th>Código</th><th>Fecha</th><th>Venta</th><th>Motivo</th><th>Registró</th><th class="text-end">Total</th><th></th></tr></thead>
    <tbody>
      <% @returns.each do |ret| %>
        <tr>
          <td class="fw-semibold"><%= ret.code %></td>
          <td><%= ret.created_at.strftime("%d/%m/%Y %H:%M") %></td>
          <td><% if can?("sales.view") %><a href="<%= sale_path(ret.sale_id) %>"><%= ret.sale&.code %></a><% else %><%= ret.sale&.code %><% end %></td>
          <td><%= ret.reason %></td>
          <td><%= ret.user&.name %></td>
          <td class="text-end num"><%= money(ret.total) %></td>
          <td class="text-end"><a href="<%= return_path(ret) %>" class="btn btn-sm btn-outline-primary"><i class="bi bi-eye"></i></a></td>
        </tr>
      <% end %>
      <% if @returns.empty? %><tr><td colspan="7" class="text-center text-muted py-4">No hay devoluciones registradas.</td></tr><% end %>
    </tbody>
  </table>
</div><div class="card-footer bg-white"><%= render "shared/pagination" %></div></div>
