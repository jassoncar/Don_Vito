# Copie este archivo a deploy/.env.production y complete los valores.
# NO lo suba a GitHub (ya está en .gitignore). Use valores entre comillas simples.
# Para contraseñas use: openssl rand -hex 16   (solo letras y números, sin símbolos problemáticos)

# --- Base de datos en AWS RDS ---
DB_HOST='<endpoint-de-rds>.us-east-2.rds.amazonaws.com'
DB_PORT='3306'
DB_DATABASE='licoreria'
DB_USERNAME='licoreria_app'
DB_PASSWORD='<clave-hex-del-usuario-de-la-app>'
DB_SSL_MODE='required'

# --- Rails ---
SECRET_KEY_BASE='<resultado de: openssl rand -hex 64>'

# --- Administrador inicial (solo para el primer seed) ---
